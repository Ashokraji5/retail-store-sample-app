
pipeline {
    agent any

    tools {
        maven 'maven'
    }

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    environment {
        DOCKER_USERNAME = 'ashokraji'
        VERSION = "1.0.${BUILD_NUMBER}"
        DOCKER_IMAGE = "${DOCKER_USERNAME}/retail-cart:${VERSION}"
        CART_DIR = 'src/cart'
    }

    stages {
        stage('Checkout Code') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/Ashokraji5/retail-store-sample-app.git',
                    credentialsId: 'github-credentials'
            }
        }

        stage('Verify Tools') {
            steps {
                sh '''
                    set -eu
                    git --version
                    java -version
                    docker --version
                    trivy --version
                '''
            }
        }

        stage('Maven Tests') {
            steps {
                dir("${CART_DIR}") {
                    sh '''
                        set -eu
                        chmod +x mvnw
                        ./mvnw -B test
                    '''
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                dir("${CART_DIR}") {
                    sh '''
                        set -eu
                        docker build --pull \
                            -t "$DOCKER_IMAGE" .
                    '''
                }
            }
        }

        stage('Trivy Security Scan') {
            steps {
                sh '''
                    set -eu
                    trivy image \
                        --severity HIGH,CRITICAL \
                        --ignore-unfixed \
                        --exit-code 1 \
                        "$DOCKER_IMAGE"
                '''
            }
        }

        stage('Push Docker Image') {
            steps {
                withDockerRegistry([
                    credentialsId: 'dockerhub-credentials',
                    url: 'https://index.docker.io/v1/'
                ]) {
                    sh '''
                        set -eu
                        docker push "$DOCKER_IMAGE"
                    '''
                }
            }
        }
    }

    post {
        success {
            echo "Cart image pushed successfully: ${DOCKER_IMAGE}"
        }

        failure {
            echo 'Pipeline failed. Check the first failing stage and its root error.'
        }

        always {
            echo 'Cart pipeline execution completed.'
        }
    }
}
