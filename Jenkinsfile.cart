
pipeline {
    agent any

    environment {
        DOCKER_USERNAME = 'ashokraji'
        VERSION = "1.0.${BUILD_NUMBER}"
        DOCKER_IMAGE = "${DOCKER_USERNAME}/retail-cart:${VERSION}"
        CART_DIR = 'src/cart'
    }

    stages {
        stage('Checkout Code') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/Ashokraji5/retail-store-sample-app.git',
                    credentialsId: 'github-credentials'
            }
        }

        stage('Verify Tools') {
            steps {
                sh '''
                    set -eu
                    git --version
                    java -version
                    docker --version
                    trivy --version
                '''
            }
        }

        stage('Cart CI') {
            when {
                anyOf {
                    changeset "src/cart/**"
                    expression {
                        currentBuild.previousBuild == null
                    }
                }
            }

            stages {
                stage('Maven Package') {
                    steps {
                        dir("${CART_DIR}") {
                            sh '''
                                set -eu
                                chmod +x mvnw
                                ./mvnw -B -DskipTests package

                                echo "Verifying Maven build output..."
                                ls -lh target/*.jar
                                test -n "$(find target -maxdepth 1 -type f -name '*.jar' -print -quit)"
                            '''
                        }
                    }
                }

                stage('Docker Build') {
                    steps {
                        dir("${CART_DIR}") {
                            sh '''
                                set -eu
                                docker build -t "$DOCKER_IMAGE" .
                            '''
                        }
                    }
                }

                stage('Trivy Security Scan') {
                    steps {
                        sh '''
                            set -eu
                            trivy image \
                                --severity HIGH,CRITICAL \
                                --exit-code 0 \
                                "$DOCKER_IMAGE"
                        '''
                    }
                }

                stage('Push Docker Image') {
                    steps {
                        withDockerRegistry([
                            credentialsId: 'dockerhub-credentials',
                            url: 'https://index.docker.io/v1/'
                        ]) {
                            sh '''
                                set -eu
                                docker push "$DOCKER_IMAGE"
                            '''
                        }
                    }
                }
            }
        }
    }

    post {
        success {
            echo "Cart CI pipeline completed. Image: ${DOCKER_IMAGE}"
        }

        failure {
            echo 'Cart CI pipeline failed. Check the Jenkins console output.'
        }

        always {
            echo 'Cart CI pipeline execution completed.'
        }
    }
}
