
pipeline {
    agent any

    environment {
        DOCKER_USERNAME = 'ashokraji'
        VERSION = "1.0.${BUILD_NUMBER}"
        DOCKER_IMAGE = "${DOCKER_USERNAME}/retail-catalog:${VERSION}"
        CATALOG_DIR = 'src/catalog'
    }

    stages {

        stage('Checkout Code') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/Ashokraji5/retail-store-sample-app.git',
                    credentialsId: 'github-credentials'
            }
        }

        stage('Verify Tools') {
            steps {
                sh '''
                    set -eu
                    git --version
                    docker --version
                    trivy --version
                '''
            }
        }

        stage('Go Unit Tests') {
            steps {
                dir("${CATALOG_DIR}") {
                    sh '''
                        set -eu

                        docker run --rm \
                            -v "$PWD:/app" \
                            -w /app \
                            golang:1.24 \
                            go test ./...
                    '''
                }
            }
        }

        stage('Docker Build') {
            steps {
                dir("${CATALOG_DIR}") {
                    sh '''
                        set -eu

                        docker build \
                            -t "$DOCKER_IMAGE" \
                            .
                    '''
                }
            }
        }

        stage('Trivy Security Scan') {
            steps {
                sh '''
                    set -eu

                    trivy image \
                        --severity HIGH,CRITICAL \
                        --exit-code 0 \
                        "$DOCKER_IMAGE"
                '''
            }
        }

        stage('Push Docker Image') {
            steps {
                withDockerRegistry([
                    credentialsId: 'dockerhub-credentials',
                    url: 'https://index.docker.io/v1/'
                ]) {
                    sh '''
                        set -eu
                        docker push "$DOCKER_IMAGE"
                    '''
                }
            }
        }
    }

    post {
        success {
            echo "Catalog image pushed successfully: ${DOCKER_IMAGE}"
        }

        failure {
            echo 'Catalog pipeline failed. Check the failed stage.'
        }

        always {
            echo 'Catalog pipeline execution completed.'
        }
    }
}
